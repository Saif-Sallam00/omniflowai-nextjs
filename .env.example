# --- Required at boot. The process refuses to start if any of these is missing. ---

# Neon Postgres, pooled connection (hostname contains "-pooler"). Used by the application at runtime.
DATABASE_URL=

# Neon Postgres, direct/unpooled connection. Used only by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Better Auth session/cookie signing secret.
BETTER_AUTH_SECRET=

# Base URL of this deployment (e.g. https://<app>.replit.app), used by Better Auth.
BETTER_AUTH_URL=

# --- Bootstrap-only. Read exclusively by scripts/bootstrap-admin.ts; application runtime code
# MUST NOT read these (ADMIN_PASSWORD is not a runtime secret). Not required at boot. ---

ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Optional. Governs production search-engine indexing. ---

# MUST NOT be set in staging/foundation deployments. When unset (default), the app emits
# X-Robots-Tag: noindex and a disallow-all robots.txt. Set to "true" only for the real
# production deployment once indexing is intended.
INDEXING_ENABLED=
