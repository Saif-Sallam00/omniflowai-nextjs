# --- Required at boot. The process refuses to start if any of these is missing. ---

# Neon Postgres, pooled connection (hostname contains "-pooler"). Used by the application at runtime.
DATABASE_URL=

# Neon Postgres, direct/unpooled connection. Used only by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Better Auth session/cookie signing secret.
BETTER_AUTH_SECRET=

# Base URL of this deployment (e.g. https://<app>.replit.app), used by Better Auth.
BETTER_AUTH_URL=

# The public site origin — no trailing slash — used to build canonicals, hreflang
# alternates, Open Graph URLs, and JSON-LD. Distinct from BETTER_AUTH_URL: this is
# the site's public identity, not the auth deployment's base URL, even though the
# two often share the same value.
SITE_URL=

# --- Bootstrap-only. Read exclusively by scripts/bootstrap-admin.ts; application runtime code
# MUST NOT read these (ADMIN_PASSWORD is not a runtime secret). Not required at boot. ---

ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Optional. Governs production search-engine indexing. ---

# MUST NOT be set in staging/foundation deployments. When unset (default), the app emits
# X-Robots-Tag: noindex and a disallow-all robots.txt. Set to "true" only for the real
# production deployment once indexing is intended.
INDEXING_ENABLED=

# --- Optional. Lead notification emails (contact form + newsletter), sent via Resend. ---

# If unset, notification emails are skipped silently (logged) — the lead is still saved to
# the database either way. The write path never depends on this being configured.
RESEND_API_KEY=

# Verified sending identity for notification emails. Falls back to Resend's shared sandbox
# sender ("OmniflowAI Leads <onboarding@resend.dev>") when unset — swap this once a real
# domain is verified in Resend (R-08).
RESEND_FROM=

# Destination for lead notification emails. Falls back to the app's contact-email constant
# (contact@omniflowai.net) when unset.
NOTIFY_EMAIL=
